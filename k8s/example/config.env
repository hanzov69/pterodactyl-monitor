# Public-facing panel URL (what users hit from the internet).
PANEL_PUBLIC_URL=https://panel.example.com
# Panel as reached over the LAN (IP or internal hostname).
PANEL_LAN_URL=http://192.168.1.10
# true if the LAN URL is https with a certificate that doesn't match (e.g. https://<ip>).
LAN_TLS_SKIP_VERIFY=false
# true if Wings nodes use self-signed certificates.
NODE_TLS_SKIP_VERIFY=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls | tls (implicit TLS, port 465) | none
SMTP_TLS=starttls
SMTP_FROM=pterodactyl-monitor@example.com
# Comma-separated for several recipients.
SMTP_TO=you@example.com

# Link included in alert emails (the dashboard's LAN address).
DASHBOARD_URL=

CHECK_INTERVAL=60s
CHECK_TIMEOUT=10s
# Consecutive failed checks before a target is DOWN and an email is sent.
FAIL_THRESHOLD=3
# Time zone used in alert emails.
TZ=UTC

# --- Optional: server monitoring (only used when PANEL_CLIENT_KEY is set in secret.env) ---
# How long a server may sit in "starting" before that counts as a failure.
# START_GRACE=15m
# Per-server service checks, as one line of JSON keyed by server name, short id
# or UUID. Types: http (url), tcp, a2s, minecraft, raknet, palworld (host/port
# default to the server's primary allocation), none.
# SERVER_CHECKS={"My Website":{"type":"http","url":"https://www.example.com"}}
